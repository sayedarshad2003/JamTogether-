# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Super Admin Passkey for Data Management & Settings
ADMIN_SECRET="admin123"

# ============================================================================
# GOOGLE OAUTH 2.0 / GOOGLE IDENTITY SERVICES CONFIGURATION
# ============================================================================
# Create OAuth 2.0 Client ID at: https://console.cloud.google.com/apis/credentials
# Ensure Authorized JavaScript origins includes: http://localhost:3000
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# ============================================================================
# AWS AMPLIFY & COGNITO CONFIGURATION (Server-Side Protected)
# ============================================================================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# AWS Cognito User Pool Configuration
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
COGNITO_CLIENT_SECRET=""

# ============================================================================
# AMAZON DYNAMODB TABLE CONFIGURATION
# ============================================================================
# Single-table and multi-table prefix for DynamoDB entities:
# Users, JamRooms, JamMembers, JamQueue, JamMessages, JamPlaybackState, Friendships, ListeningHistory
DYNAMODB_TABLE_PREFIX="JamTogether_"
DYNAMODB_ENDPOINT=""

# ============================================================================
# AWS API GATEWAY / APPSYNC REAL-TIME CONFIGURATION
# ============================================================================
AWS_APPSYNC_GRAPHQL_ENDPOINT=""
AWS_APIGW_WEBSOCKET_URL=""

# ============================================================================
# YOUTUBE DATA API v3 (Server-Side Proxy)
# ============================================================================
YOUTUBE_API_KEY=""

# ============================================================================
# WEBRTC ICE / STUN / TURN SERVERS
# ============================================================================
VITE_STUN_SERVER_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
VITE_TURN_SERVER_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""
